# --- Supabase ---
PB_SUPABASE_URL=https://xxxx.supabase.co
PB_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL pública del worker (Railway/Render), sin / al final
PB_WORKER_URL=https://mascotas-worker.up.railway.app

# URL de esta web (para regresos de Mercado Pago y OAuth), sin / al final
SITE_URL=https://mascotaslive.com

# Igual que en el worker: 32 bytes en base64 (openssl rand -base64 32)
TOKENS_KEY=

# --- Mercado Pago (cobra en MXN) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Twitch (dev.twitch.tv/console) — redirect: SITE_URL/api/conectar/twitch/callback ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Facebook (developers.facebook.com) — redirect: SITE_URL/api/conectar/facebook/callback ---
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_VERSION=v23.0

# --- IA (mascotas creadas con Claude) ---
ANTHROPIC_API_KEY=
